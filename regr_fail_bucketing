def _open_log(file_path):
    """Open a log file transparently, supporting both plain and gzip (.gz) files."""
    if not os.path.exists(file_path) or os.path.getsize(file_path) == 0:
        return None
    if file_path.endswith(".gz"):
        return gzip.open(file_path, "rt", encoding="utf-8", errors="replace")
    return open(file_path, "r", encoding="utf-8", errors="replace")


def _read_head_bytes(file_path, nbytes):
    """Decompress at most `nbytes` of a (possibly gzipped) log and return text.
    used for the trace log where required signal is only first few hundred instructions
    """
    if not file_path or not os.path.exists(file_path) or os.path.getsize(file_path) == 0:
        return ""
    try:
        opener = gzip.open if file_path.endswith(".gz") else open
        with opener(file_path, "rb") as f:
            return f.read(nbytes).decode("utf-8", "replace")
    except Exception:
        return ""


_TRACE_ANCHOR_BEFORE_ROWS = 20
_TRACE_ANCHOR_SCAN_CAP = 1 << 20

def _read_anchored_text(file_path, anchor_pc, before_rows=_TRACE_ANCHOR_BEFORE_ROWS,
                         after_rows=100, scan_cap=_TRACE_ANCHOR_SCAN_CAP):
    """focus on anchor_pc appearing the first time, to avoid the same form's cases injects
        the different bugs. 
    """
    if not anchor_pc or not file_path or not os.path.exists(file_path) \
            or os.path.getsize(file_path) == 0:
        return None
    anchor_norm = anchor_pc.lstrip("0").lower() or "0"
    try:
        opener = gzip.open if file_path.endswith(".gz") else open
        with opener(file_path, "rt", encoding="utf-8", errors="replace") as f:
            header = f.readline()
            before = collections.deque(maxlen=before_rows)
            scanned = 0
            found_lines = None
            for line in f:
                scanned += len(line)
                cols = line.split("\t")
                pc = cols[2].lstrip("0").lower() if len(cols) > 2 else ""
                if pc == anchor_norm:
                    found_lines = list(before)
                    found_lines.append(line)
                    for _ in range(after_rows - 1):
                        nxt = f.readline()
                        if not nxt:
                            break
                        found_lines.append(nxt)
                    break
                before.append(line)
                if scanned >= scan_cap:
                    break
            if found_lines is None:
                return None
            return header + "".join(found_lines)
    except Exception:
        return None


# --- divergence fingerprint ---
_DIV_SIDE_RE = re.compile(r"^\s*(ibex|spike)\[(\d+)\]\s*:")
_DIV_RV_RE = re.compile(r"([a-z][a-z0-9]*)\s*:\s*([0-9a-fA-F]{8})\s*$")
# pc on either side of a Mismatch[N] entry, for the PC-skew feature below
_DIV_PC_RE = re.compile(r"pc\[([0-9a-fA-F]+)\]")
_DIV_N_FLAGS = 10


def _summarize_divergence(features, div_pairs):
    """Reduce paired (ibex, spike) retired writes to rate vectors."""
    bits = [0.0] * 32
    flags = [0.0] * _DIV_N_FLAGS
    n = 0
    for idx in sorted(div_pairs):
        d = div_pairs[idx]
        if "ibex" not in d or "spike" not in d:
            continue
        (i_reg, i_val), (s_reg, s_val) = d["ibex"], d["spike"]
        n += 1
        x = (i_val ^ s_val) & 0xFFFFFFFF
        for b in range(32):
            if x >> b & 1:
                bits[b] += 1.0
        pop = bin(x).count("1")
        flags[0] += i_val == 0
        flags[1] += s_val == 0
        flags[2] += x == 0xFFFFFFFF          # fully inverted
        flags[3] += pop == 1                 # single-bit flip
        flags[4] += i_val == (s_val + 1) & 0xFFFFFFFF
        flags[5] += i_val == (s_val - 1) & 0xFFFFFFFF
        flags[6] += (x & 0x0000FFFF) == 0    # only the high half differs
        flags[7] += (x & 0xFFFF0000) == 0    # only the low half differs
        flags[8] += i_reg != s_reg           # wrote a different register
        flags[9] += i_val == 0xFFFFFFFF
    if n:
        features["div_bits"] = [b / n for b in bits]
        features["div_flags"] = [float(f) / n for f in flags]
        features["n_div"] = n


def extract_regr_features(file_path):
    """
    Extracts mismatch PCs, failed test names, and match/mismatch statistics using purely Regex.
    Safe against empty or corrupted files.
    """
    features = {
        "mismatch_pc": None,
        "failed_test_name": None,
        "matched_count": 0,
        "mismatch_count": 0,
        # mistmach instructions -- where exactly the behavior doesn't match expected
        "mismatch_insns": [],
        # divergence fingerprint
        "div_bits": [0.0] * 32,
        "div_flags": [0.0] * _DIV_N_FLAGS,
        "n_div": 0,
        # sizes/counts feeding the numeric fingerprint below
        "n_mism_lines": 0,
        "regr_len": 0,
        # PC skew at the first divergence
        "pc_skew": None,
    }

    f = _open_log(file_path)
    if f is None:
        return features

    # index -> {"ibex": (reg, value), "spike": (reg, value)}; the two sides of
    # one Mismatch[N] entry are paired on N.
    div_pairs = {}
    # index -> {"ibex": pc, "spike": pc} for the first paired Mismatch entry
    pc_sides = {}

    with f:
        for line in f:
            features["regr_len"] += len(line)

            # 0. Retired (register, value) on either side of a divergence.
            side = _DIV_SIDE_RE.match(line)
            if side:
                rv = _DIV_RV_RE.search(line)
                if rv:
                    div_pairs.setdefault(int(side.group(2)), {})[side.group(1)] = (
                        rv.group(1), int(rv.group(2), 16))
                pc = _DIV_PC_RE.search(line)
                if pc:
                    pc_sides.setdefault(int(side.group(2)), {})[side.group(1)] = \
                        int(pc.group(1), 16)

            # 1. Isolate exact point of mismatch; capture instruction + regard for newline.
            mismatch_match = re.search(
                r"ibex\[\d+\]\s*:\s*pc\[([0-9a-fA-F]+)\]\s+([a-z][a-z0-9._]*)?",
                line)
            if mismatch_match:
                features["n_mism_lines"] += 1
                if not features["mismatch_pc"]:
                    features["mismatch_pc"] = mismatch_match.group(1)
                mnem = mismatch_match.group(2)
                if mnem and len(features["mismatch_insns"]) < 8:
                    features["mismatch_insns"].append(mnem.replace(".", "_"))

            # 2. Capture the testbench verdict
            failed_match = re.search(r"^([a-zA-Z0-9_.]+)\s*:\s*\[FAILED\]", line)
            if failed_match:
                features["failed_test_name"] = failed_match.group(1)

            # 3. Capture the final match/mismatch statistics
            stat_pattern = r"(\d+)\s+matched,\s+(\d+)\s+mismatch"
            stats = re.search(stat_pattern, line)
            if stats:
                features["matched_count"] = int(stats.group(1))
                features["mismatch_count"] = int(stats.group(2))

    for idx in sorted(pc_sides):
        pair = pc_sides[idx]
        if "ibex" in pair and "spike" in pair:
            # spike prints a sign-extended 64-bit pc; compare the low 32 bits
            features["pc_skew"] = abs((pair["ibex"] & 0xFFFFFFFF)
                                      - (pair["spike"] & 0xFFFFFFFF))
            break

    _summarize_divergence(features, div_pairs)
    return features


def extract_sim_features(file_path):
    """
    Scans for UVM report macros and timeouts in the VCS simulator console log using Regex.
    Safe against empty or corrupted files.
    
    added: riscv_test, fatal_src, assert_name
    added: src_sites, all the assertions it triggers (turn to sets)
    """
    features = {
        "uvm_fatal": False,
        "uvm_error": False,
        "is_timeout": False,
        # new keys
        "riscv_test": None,
        "fatal_src": None,
        "fatal_src_is_rtl": False,
        "assert_name": None,
        # new keys 2
        "src_sites": set(),
        "assert_names": set(),
        # (generated program, simulation seed) -- see _PROG_* below
        "prog_id": None,
    }

    f = _open_log(file_path)
    if f is None:
        return features

    prog_bin = prog_seed = None
    macro_re = re.compile(r"\bUVM_(FATAL|ERROR)\b\s+\S+\(\d+\)\s*@")
    summary_re = re.compile(r"^\s*UVM_(FATAL|ERROR)\s*:\s*(\d+)\s*$")
    # allow the seed suffix on the generated-program name
    testname_re = re.compile(r"\briscv_[a-z0-9_]+?_test(?=_\d|\b)")
    # source location of the report macro: capture the full path + line num
    src_re = re.compile(r"\bUVM_(?:FATAL|ERROR)\s+(\S*?)([A-Za-z0-9_]+\.sv)\((\d+)\)")
    #  assertion leaf name: last dotted component inside [ASSERT FAILED]
    assert_re = re.compile(r"ASSERT FAILED\]\s*\[[^]]*?([A-Za-z0-9_]+)\]")

    first_macro_line = None

    with f:
        for lineno, line in enumerate(f):
            # Bound the scan
            if lineno > _SIM_SCAN_LINES:
                break
            if (features["riscv_test"] is not None
                    or lineno >= _TESTNAME_SCAN_LINES):
                if len(features["src_sites"]) >= _MAX_SRC_SITES:
                    break
                if (first_macro_line is not None
                        and lineno > first_macro_line + _SRC_SCAN_EXTRA):
                    break

            # grab generated test name from the early header lines, first hit is it
            if features["riscv_test"] is None and lineno < _TESTNAME_SCAN_LINES:
                t = testname_re.search(line)
                if t:
                    features["riscv_test"] = t.group(0)

            # program identity
            if prog_bin is None and lineno < _TESTNAME_SCAN_LINES:
                pb = _PROG_BIN_RE.search(line)
                if pb:
                    prog_bin = pb.group(1).rsplit("/", 1)[-1]
                ps = _PROG_SEED_RE.search(line)
                if ps:
                    prog_seed = ps.group(1)

            m = macro_re.search(line)
            if m:
                if first_macro_line is None:
                    first_macro_line = lineno
                if m.group(1) == "FATAL":
                    features["uvm_fatal"] = True
                    if "timeout" in line.lower():
                        features["is_timeout"] = True
                else:
                    features["uvm_error"] = True

                # remember where the first report macro fired and which assertion (if any) it names
                s2 = src_re.search(line)
                if s2:
                    site = f"{s2.group(2)}({s2.group(3)})"
                    if len(features["src_sites"]) < _MAX_SRC_SITES:
                        features["src_sites"].add(site)
                    if features["fatal_src"] is None:
                        features["fatal_src"] = site
                        # Split RTL-fired from testbench-fired reports
                        path = s2.group(1)
                        features["fatal_src_is_rtl"] = (
                            "/rtl/" in path or "prim_assert" in s2.group(2)
                        )
                a = assert_re.search(line)
                if a:
                    if features["assert_name"] is None:
                        features["assert_name"] = a.group(1)
                    if len(features["assert_names"]) < _MAX_SRC_SITES:
                        features["assert_names"].add(a.group(1))
                continue

            s = summary_re.match(line)
            if s:
                count = int(s.group(2))
                if count > 0:
                    if s.group(1) == "FATAL":
                        features["uvm_fatal"] = True
                    else:
                        features["uvm_error"] = True

    if prog_bin:
        features["prog_id"] = "%s@%s" % (prog_bin, prog_seed or "?")
    return features


_PROG_BIN_RE = re.compile(r"\+bin=(\S+)")
_PROG_SEED_RE = re.compile(r"\+ntb_random_seed=(\d+)")

# generated test name lives in the first ~100 header lines of sim.log
_TESTNAME_SCAN_LINES = 400
# cap on how far into a sim.log we scan for the first report macro
_SIM_SCAN_LINES = 300_000
# how many distinct report sites / assertion names to collect
_MAX_SRC_SITES = 6
# how far past the first report macro to keep scanning for further distinct sites
_SRC_SCAN_EXTRA = 2000

